        float quantity
        string reference
        text note
        boolean is_reversal
        string reversed_transaction_id
        text reversal_reason
        datetime created_at
        datetime updated_at
        string created_by
    }

    weighbridge_tickets {
        string id PK
        string ticket_number UK
        string type
        string vehicle_number
        string material
        string supplier_or_customer
        float gross_weight
        float tare_weight
