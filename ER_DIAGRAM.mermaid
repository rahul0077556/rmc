    }

    tm_trip_logs {
        string id PK
        string date
        string driver_name
        string truck_number
        float truck_capacity_cum
        float start_km
        float end_km
        float running_km
        float handi_start_hr
        float handi_closing_hr
        float handi_running_hr
        float extra_handi_hr
        float opening_diesel_l
        float issued_diesel_l
        float closing_diesel_l
        float actual_diesel_consumed_l
        float km_per_liter
        int trips_count
        float concrete_volume_cum
        string remarks
        datetime created_at
        datetime updated_at
        string created_by
    }

    dpr_records {
        string id PK
        string date UK
